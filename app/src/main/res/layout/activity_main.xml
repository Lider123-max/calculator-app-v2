<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:textSize="42sp"
        android:textColor="@color/text_white"
        android:gravity="end|center_vertical"
        android:background="@color/display_bg"
        android:text="0"
        android:padding="20dp"
        android:layout_marginBottom="8dp"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5">

        <Button android:text="sin" android:onClick="onFunction" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textSize="13sp" android:textColor="@color/text_white" android:backgroundTint="@color/function_btn"/>
        <Button android:text="cos" android:onClick="onFunction" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textSize="13sp" android:textColor="@color/text_white" android:backgroundTint="@color/function_btn"/>
        <Button android:text="tan" android:onClick="onFunction" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textSize="13sp" android:textColor="@color/text_white" android:backgroundTint="@color/function_btn"/>
        <Button android:text="log" android:onClick="onFunction" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textSize="13sp" android:textColor="@color/text_white" android:backgroundTint="@color/function_btn"/>
        <Button android:text="√" android:onClick="onFunction" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textSize="13sp" android:textColor="@color/text_white" android:backgroundTint="@color/function_btn"/>

        <Button android:text="x²" android:onClick="onFunction" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textSize="13sp" android:textColor="@color/text_white" android:backgroundTint="@color/function_btn"/>
        <Button android:text="^" android:onClick="onOperator" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/operator_btn"/>
        <Button android:text="π" android:onClick="onFunction" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textSize="13sp" android:textColor="@color/text_white" android:backgroundTint="@color/function_btn"/>
        <Button android:text="C" android:onClick="onClear" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/operator_btn"/>
        <Button android:text="/" android:onClick="onOperator" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/operator_btn"/>

        <Button android:text="7" android:onClick="onDigit" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/digit_btn"/>
        <Button android:text="8" android:onClick="onDigit" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/digit_btn"/>
        <Button android:text="9" android:onClick="onDigit" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/digit_btn"/>
        <Button android:text="(" android:onClick="onDigit" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/digit_btn"/>
        <Button android:text="*" android:onClick="onOperator" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/operator_btn"/>

        <Button android:text="4" android:onClick="onDigit" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/digit_btn"/>
        <Button android:text="5" android:onClick="onDigit" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/digit_btn"/>
        <Button android:text="6" android:onClick="onDigit" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/digit_btn"/>
        <Button android:text=")" android:onClick="onDigit" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/digit_btn"/>
        <Button android:text="-" android:onClick="onOperator" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/operator_btn"/>

        <Button android:text="1" android:onClick="onDigit" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/digit_btn"/>
        <Button android:text="2" android:onClick="onDigit" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/digit_btn"/>
        <Button android:text="3" android:onClick="onDigit" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/digit_btn"/>
        <Button android:text="." android:onClick="onDigit" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/digit_btn"/>
        <Button android:text="+" android:onClick="onOperator" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/operator_btn"/>

        <Button android:text="0" android:onClick="onDigit" android:layout_columnWeight="2" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/digit_btn"/>
        <Button android:text="=" android:onClick="onEquals" android:layout_columnWeight="3" android:layout_width="0dp" android:layout_height="65dp" android:layout_margin="2dp" android:textColor="@color/text_white" android:backgroundTint="@color/equals_btn"/>

    </GridLayout>
</LinearLayout>
</ScrollView>
